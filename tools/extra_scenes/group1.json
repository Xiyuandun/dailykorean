{
  "day1": [
    {
      "scene": "初次见面自我介绍",
      "situationZh": "在语学院初次见到韩国同学，互相打招呼并了解对方的国籍。",
      "roles": { "clerk": "同学", "user": "我" },
      "turns": [
        { "role": "clerk", "ko": "안녕하세요! 저는 김민수예요.", "phonetic": "annyeonghaseyo! jeoneun giminsu-ye-yo.", "zh": "你好！我是金敏秀。" },
        { "role": "user", "ko": "안녕하세요. 저는 유진이라고 해요.", "phonetic": "annyeonghaseyo. jeoneun yujin-i-rago haeyo.", "zh": "你好。我叫裕珍。" },
        { "role": "clerk", "ko": "만나서 반가워요. 유진 씨는 한국 사람이에요?", "phonetic": "mannaseo bangawoyo. yujin ssineun hanguk saram-i-e-yo?", "zh": "很高兴见到你。裕珍是韩国人吗？" },
        { "role": "user", "ko": "아니요, 저는 중국 사람이에요.", "phonetic": "aniyo, jeoneun jungguk saram-i-e-yo.", "zh": "不是，我是中国人。" },
        { "role": "clerk", "ko": "아, 정말요? 한국어를 정말 잘 하시네요!", "phonetic": "a, jeongmallyo? hangug-eoreul jeongmal jal hasineyo!", "zh": "啊，真的吗？你韩语说得真好啊！" },
        { "role": "user", "ko": "아직 배우는 중이에요.", "phonetic": "ajik baeuneun jung-i-e-yo.", "zh": "我还在学习当中。" }
      ],
      "tips": [
        "见面时用「안녕하세요」问好，回答时也要回「안녕하세요」。",
        "告诉名字时用「이름은…예요」或「…이라고 해요」。",
        "「반가워요」表示“很高兴”，初次见面常用「만나서 반가워요」。"
      ]
    },
    {
      "scene": "早上和同事打招呼",
      "situationZh": "早上上班时在办公室门口遇到同事，互相问候并约好一起吃午饭。",
      "roles": { "clerk": "同事", "user": "我" },
      "turns": [
        { "role": "clerk", "ko": "안녕하세요! 좋은 아침이에요.", "phonetic": "annyeonghaseyo! joeun achim-i-e-yo.", "zh": "你好！早上好。" },
        { "role": "user", "ko": "안녕하세요! 오늘도 힘내요!", "phonetic": "annyeonghaseyo! oneuldo himnaeyo!", "zh": "你好！今天也加油！" },
        { "role": "clerk", "ko": "네, 고마워요. 오늘 일이 많아요?", "phonetic": "ne, gomawoyo. oneul iri mannayo?", "zh": "嗯，谢谢。今天工作多吗？" },
        { "role": "user", "ko": "좀 있어요. 하지만 괜찮아요.", "phonetic": "jom isseoyo. hajiman gwaenchanayo.", "zh": "有点多，但没关系。" },
        { "role": "clerk", "ko": "그럼 같이 점심을 먹어요.", "phonetic": "geureom gachi jeomsimeul meogeoyo.", "zh": "那我们一起吃午饭吧。" },
        { "role": "user", "ko": "좋아요! 그렇게 해요.", "phonetic": "joayo! geureoke haeyo.", "zh": "好呀！就这么办。" }
      ],
      "tips": [
        "早上见面的问候语是「좋은 아침이에요」或更正式的「좋은 아침입니다」。",
        "「힘내요」表示“加油”，常用来鼓励身边的人。",
        "提议一起做某事时用「같이…해요」。"
      ]
    },
    {
      "scene": "和邻居打招呼",
      "situationZh": "刚搬来新家，在楼梯间遇到邻居，互相认识并允许对方遇到困难时求助。",
      "roles": { "clerk": "邻居", "user": "我" },
      "turns": [
        { "role": "clerk", "ko": "안녕하세요! 새로 이사 오셨어요?", "phonetic": "annyeonghaseyo! saero isa osyeosseoyo?", "zh": "你好！您是刚搬过来的吗？" },
        { "role": "user", "ko": "네, 어제 이사 왔어요. 잘 부탁드려요.", "phonetic": "ne, eoje isa wasseoyo. jal butakdeuryeoyo.", "zh": "是的，我昨天搬过来的。请多关照。" },
        { "role": "clerk", "ko": "저는 옆집에 사는 김 씨예요.", "phonetic": "jeoneun yeopjie saneun gim ssieyo.", "zh": "我是住在隔壁的金先生。" },
        { "role": "user", "ko": "만나서 반가워요. 저는 유진이에요.", "phonetic": "mannaseo bangawoyo. jeoneun yujin-i-e-yo.", "zh": "很高兴认识你，我是裕珍。" },
        { "role": "clerk", "ko": "혹시 도움이 필요하면 말씀해요.", "phonetic": "hoksi doumi piryohamyeon malsseumhaeyo.", "zh": "如果有什么需要帮助的就跟我说。" },
        { "role": "user", "ko": "감사합니다. 정말 고마워요.", "phonetic": "gamsahamnida. jeongmal gomawoyo.", "zh": "谢谢，真的太感谢了。" }
      ],
      "tips": [
        "对长辈或初次见面的人使用敬语「…세요」和「말씀하세요」。",
        "「잘 부탁드려요」是“请多关照”的常用表达。",
        "搬家用动词「이사 오다」，表示“搬过来”。"
      ]
    }
  ],
  "day2": [
    {
      "scene": "请韩国朋友教韩语",
      "situationZh": "和朋友一起学习韩语，朋友讲某个生词的意思。",
      "roles": { "clerk": "朋友", "user": "我" },
      "turns": [
        { "role": "clerk", "ko": "오늘은 어떤 걸 배울까요?", "phonetic": "oneureun eotteon geol ba-ulkkayo?", "zh": "今天想学点什么呢？" },
        { "role": "user", "ko": "오늘은 한국어 문법을 배우고 싶어요.", "phonetic": "oneureun hangug-eo munbeobeul baeugo sipeoyo.", "zh": "今天想学韩语语法。" },
        { "role": "clerk", "ko": "좋아요. 그럼 여기부터 시작해요.", "phonetic": "joayo. geureom yeogi-buteo sijakhaeyo.", "zh": "好啊，那我们从这里开始吧。" },
        { "role": "user", "ko": "그런데 \"안녕\"은 무슨 뜻이에요?", "phonetic": "geureonde \"annyeong\"-eun museun tteusi-e-yo?", "zh": "不过，“안녕”是什么意思呢？" },
        { "role": "clerk", "ko": "\"안녕\"은 인사말이에요.", "phonetic": "\"annyeong\"-eun insa-mari-e-yo.", "zh": "“안녕”是问候语。" },
        { "role": "user", "ko": "아하, 알겠어요! 감사해요.", "phonetic": "aha, algesseoyo! gamsahaeyo.", "zh": "啊哈，明白了！谢谢你。" }
      ],
      "tips": [
        "「…을/를 배우고 싶어요」表示“我想学……”。",
        "「무슨」作定语，表示“什么样的、什么”。",
        "「…은 무슨 뜻이에요?」用于询问“……是什么意思”。"
      ]
    },
    {
      "scene": "在书店买韩语教材",
      "situationZh": "在书店让店员推荐适合初学者的韩语教材，并询问价格。",
      "roles": { "clerk": "店员", "user": "我" },
      "turns": [
        { "role": "clerk", "ko": "어떤 책을 찾으세요?", "phonetic": "eotteon chaegeul chajeuseyo?", "zh": "您在找什么书呢？" },
        { "role": "user", "ko": "한국어 교재를 찾고 있어요.", "phonetic": "hangug-eo gyojae-reul chatgo isseoyo.", "zh": "我在找韩语教材。" },
        { "role": "clerk", "ko": "이 책은 입문자에게 딱 좋아요.", "phonetic": "i chaegeun imunjae-ge ttak joayo.", "zh": "这本书很适合初学者。" },
        { "role": "user", "ko": "이 책은 얼마예요?", "phonetic": "i chaegeun eol-maye-yo?", "zh": "这本书多少钱？" },
