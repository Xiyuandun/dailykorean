        { "role": "user", "ko": "비싸네요. 좀 싼 책은 없어요?", "phonetic": "bissangeyo. jom ssan chaegeun eopseoyo?", "zh": "有点贵。有便宜一点的书吗？" }
      ],
      "tips": [
        "「얼마예요?」用来询问价格，意为“多少钱？”。",
        "数字中「만」表示一万，「오천」表示五千。",
        "「딱 좋아요」表示“正合适、刚好”。"
      ]
    },
    {
      "scene": "请老师纠正发音",
      "situationZh": "韩语课上老师带学生做发音练习，并表扬学生发音准确。",
      "roles": { "clerk": "老师", "user": "我" },
      "turns": [
        { "role": "clerk", "ko": "오늘은 발음 연습을 해 볼게요.", "phonetic": "oneureun barum yeonseubeul hae bolgeyo.", "zh": "今天我们来做发音练习。" },
        { "role": "user", "ko": "이 단어를 어떻게 읽어요?", "phonetic": "i daneoreul eoddeoke ilgeoyo?", "zh": "这个单词怎么读？" },
        { "role": "clerk", "ko": "천천히 다시 말해 보세요.", "phonetic": "cheoncheonhi dasi malhae boseyo.", "zh": "请慢慢再说一遍。" },
        { "role": "user", "ko": "\"키가 커요\". 맞아요?", "phonetic": "\"kiga keoyo\". majayo?", "zh": "“키가 커요”，对吗？" },
        { "role": "clerk", "ko": "아주 잘했어요! 발음이 좋아요.", "phonetic": "aju jareosseoyo! barumi joayo.", "zh": "说得非常好！发音很好。" },
        { "role": "user", "ko": "정말요? 기분이 너무 좋아요.", "phonetic": "jeongmallyo? gibuni neomu joayo.", "zh": "真的吗？我心情太好了。" }
      ],
      "tips": [
        "「어떻게 읽어요?」表示“怎么读？”，是询问读法常用句。",
        "「천천히」表示“慢慢地”，请求对方放慢语速时用。",
        "「…해 보세요」表示“请尝试着做……”，是委婉的请求。"
      ]
    }
  ],
  "day3": [
    {
      "scene": "冬天下雪",
      "situationZh": "冬天看到窗外下雪，和朋友讨论天气并提议一起堆雪人。",
      "roles": { "clerk": "朋友", "user": "我" },
      "turns": [
        { "role": "clerk", "ko": "와, 오늘 눈이 와요!", "phonetic": "wa, oneul nuni wayo!", "zh": "哇，今天下雪了！" },
        { "role": "user", "ko": "정말 예뻐요. 추워서 두꺼운 옷을 입었어요.", "phonetic": "jeongmal yeppeoyo. chuwo-seo dukkeoun oseul ibeosseoyo.", "zh": "真漂亮。太冷了，所以穿了厚衣服。" },
        { "role": "clerk", "ko": "그래요. 겨울에는 눈이 자주 와요.", "phonetic": "geuraeyo. gyeoul-eneun nuni jaju wayo.", "zh": "是啊。冬天经常下雪。" },
        { "role": "user", "ko": "같이 눈사람을 만들어 볼래요?", "phonetic": "gachi nunsarameul mandeuleo bol-laeyo?", "zh": "我们一起堆个雪人好吗？" },
        { "role": "clerk", "ko": "좋아요! 하지만 손이 너무 차요.", "phonetic": "joayo! hajiman soni neomu chayo.", "zh": "好呀！但是手太冷了。" },
        { "role": "user", "ko": "장갑을 끼고 하면 돼요.", "phonetic": "jang-ga-beul kkigo hamyeon dwaeyo.", "zh": "戴上手套做就行。" }
