{
  "day26": [
    {
      "scene": "시험 전 긴장",
      "situationZh": "考试前一天，向朋友诉说自己的紧张心情并寻求安慰。",
      "roles": {"clerk": "朋友", "user": "我"},
      "turns": [
        {"role": "user", "ko": "내일 시험이 있어서 너무 긴장돼요.", "phonetic": "Naeil siheomi isseoseo neomu ginjangdoeyo.", "zh": "明天有考试，我特别紧张。"},
        {"role": "clerk", "ko": "괜찮아요, 열심히 준비했으니까 자신 있어요.", "phonetic": "Gwaenchanayo, yeolsimhi junbihaesseunikka jasin isseoyo.", "zh": "没关系，你好好准备了，要有信心。"},
        {"role": "user", "ko": "그런데 마음이 너무 불안해요.", "phonetic": "Geureonde maeumi neomu buranhae-yo.", "zh": "可是我心里太不安了。"},
        {"role": "clerk", "ko": "깊게 숨을 쉬면서 천천히 생각해 보세요.", "phonetic": "Gipge sumeul swimyeonseo cheoncheonhi saenggakhae boseyo.", "zh": "深呼吸，然后慢慢思考吧。"},
        {"role": "user", "ko": "조언해 주셔서 마음이 좀 편해졌어요.", "phonetic": "Jo-eonhae jusyeoseo maeumi jom pyeonhaejyeosseoyo.", "zh": "听了你的建议，我心里舒服了一点。"},
        {"role": "clerk", "ko": "다음에 또 긴장되면 언제든지 연락하세요.", "phonetic": "Daeume tto ginjangdoemyeon eonjedeunji yeollakhaseyo.", "zh": "下次再紧张的话，随时联系我。"}
      ],
      "tips": ["“긴장되다”表示紧张，口语里也常说“떨리다”。","“마음이 불안하다”是形容心里不安，非常常用。","安慰别人时常说“괜찮아요”和“자신 있어요（有信心）”。"]
    },
    {
      "scene": "슬픈 친구 위로",
      "situationZh": "朋友因为离别而难过，在一旁倾听并安慰他。",
      "roles": {"clerk": "朋友", "user": "我"},
      "turns": [
        {"role": "clerk", "ko": "친구가 외국으로 가서 너무 슬퍼요.", "phonetic": "Chinguga oekkeuro gaseo neomu seulpeoyo.", "zh": "朋友去国外了，我太难过了。"},
        {"role": "user", "ko": "그게 정말 안타깝네요. 많이 보고 싶겠어요.", "phonetic": "Geuge jeongmal antakkapneyo. Mani bogosipgess-eoyo.", "zh": "那真是太让人难过了，一定很想念吧。"},
        {"role": "clerk", "ko": "네, 생각만 해도 눈물이 나요.", "phonetic": "Ne, saenggakman haedo nunmuri nayo.", "zh": "嗯，一想到就忍不住掉眼泪。"},
        {"role": "user", "ko": "힘들 테지만 잘 이겨낼 수 있을 거예요.", "phonetic": "Himdeul tejiman jal igyeonael su isseul geoyeyo.", "zh": "虽然会辛苦，但你一定能挺过去。"},
        {"role": "clerk", "ko": "지금은 조금만 울어도 되죠?", "phonetic": "Jigeumeun jogeumman ureodo doejyo?", "zh": "现在稍微哭一下也没关系吧？"},
        {"role": "user", "ko": "물론이죠, 눈물을 흘리면 마음이 더 가벼워요.", "phonetic": "Mullonimjyo, nunmureul heullimyeon maeumi deo gabyeowoyo.", "zh": "当然啦，哭出来心里会更轻松。"}
      ],
      "tips": ["“슬프다”是形容词“难过”，名词形式是“슬픔”。","“눈물이 나요”表示“流眼泪”，很形象。","安慰他人可用“괜찮아요”和“이겨낼 수 있어요（能挺过去）”。"]
    },
    {
      "scene": "좋은 소식 전하기",
      "situationZh": "拿到好消息，开心地告诉朋友并一起分享喜悦。",
      "roles": {"clerk": "朋友", "user": "我"},
      "turns": [
        {"role": "user", "ko": "드디어 승진했어요! 정말 기뻐요.", "phonetic": "Deudieo seungjinhaesseoyo! Jeongmal gippeoyo.", "zh": "我终于升职了！真高兴。"},
        {"role": "clerk", "ko": "와, 진짜 축하해요! 정말 대단해요.", "phonetic": "Wa, jinjja chukhahaeyo! Jeongmal daedanhaeyo.", "zh": "哇，真的恭喜你！太厉害了。"},
        {"role": "user", "ko": "고마워요. 지금 기분이 너무 좋아서 설레요.", "phonetic": "Gomawoyo. Jigeum gibuni neomu joaseo seollaeyo.", "zh": "谢谢你，我现在心情太好，激动得不行。"},
        {"role": "clerk", "ko": "그동안의 노력이 드디어 인정받은 거예요.", "phonetic": "Geudong-an-ui noryeogi deudieo injeongbadeun geoyeyo.", "zh": "这段时间的努力终于得到认可了。"},
        {"role": "user", "ko": "그래서 오늘 저녁에 같이 밥 먹어요.", "phonetic": "Geuraeseo oneul jeonyeoge gachi bap meogeoyo.", "zh": "所以今天晚上一起吃饭吧。"},
        {"role": "clerk", "ko": "좋아요! 기쁜 일은 다 같이 축하해야죠.", "phonetic": "Joayo! Gippeun ireun da gachi chukhahaeyajyo.", "zh": "好啊！高兴的事就该大家一起庆祝。"}
      ],
      "tips": ["“승진하다”是“升职”，和“축하하다(祝贺)”搭配使用。","“정말 대단해요”表示“真了不起”，用来称赞他人。","“설레요”是心动、激动，常用于喜事。"]
    }
  ],
  "day27": [
    {
      "scene": "회의 시간 정하기",
      "situationZh": "在办公室里和同事商量会议的合适时间。",
      "roles": {"clerk": "同事", "user": "我"},
      "turns": [
        {"role": "clerk", "ko": "회의 시간을 언제로 할까요?", "phonetic": "Hoeui siganeul eonjero halkkayo?", "zh": "会议时间定在几点好呢？"},
        {"role": "user", "ko": "오후 2시가 어떨까요?", "phonetic": "Ohu dusi-ga eotteolkka-yo?", "zh": "下午两点怎么样？"},
        {"role": "clerk", "ko": "저는 2시에 다른 약속이 있어서 어려워요.", "phonetic": "Jeoneun dusi-e dareun yaksok-i isseoseo eoryeowoyo.", "zh": "我两点有其他约定，不太方便。"},
        {"role": "user", "ko": "그러면 4시는 괜찮으세요?", "phonetic": "Geureomyeon nesi-neun gwaenchan-euseyo?", "zh": "那四点可以吗？"},
        {"role": "clerk", "ko": "네, 4시가 좋겠어요. 회의실을 예약할게요.", "phonetic": "Ne, nesi-ga jogess-eoyo. Hoeuisireul yeyakhalgeyo.", "zh": "好的，四点可以。我去预约会议室。"},
        {"role": "user", "ko": "네, 그러면 보고서도 준비해서 갈게요.", "phonetic": "Ne, geureomyeon bogoseo-do junbihaeseo galgeyo.", "zh": "好的，那我准备好报告再过去。"}
      ],
      "tips": ["询问会议时间常用“언제로 할까요（定在什么时候）”。","“어떨까요”用来征询意见，比“어때요”更客气。","“회의실을 예약하다”是预约会议室的常用表达。"]
    },
    {
